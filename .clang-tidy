---
# Static analysis profile for PulseLog.
#
# The enabled set focuses on the classes of defect that actually matter for a
# storage/networking engine: ownership mistakes, narrowing conversions on wire
# and offset arithmetic, accidental copies on hot paths, and undefined
# behaviour. Stylistic checks that fight the chosen formatting are disabled.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  concurrency-*,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-const-return-type,
  readability-container-size-empty,
  readability-misleading-indentation,
  readability-redundant-*,
  readability-simplify-boolean-expr,
  readability-string-compare,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  # Specialising std::hash for our own types is the standard way to make them
  # usable as unordered_map keys, and is explicitly permitted.
  -bugprone-std-namespace-modification,
  -cert-dcl58-cpp,
  # Fires on the temporary *variable name* inside PL_ASSIGN_OR_RETURN, which
  # cannot be parenthesised. The macro's actual arguments are parenthesised.
  -bugprone-macro-parentheses,
  -cert-err58-cpp,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-no-recursion,
  # Misfires on out-of-line member function definitions, claiming a class
  # method could have internal linkage.
  -misc-use-internal-linkage,
  # Too noisy to be actionable: it wants `const` on nearly every local.
  -misc-const-correctness,
  # Wants uint8_t bases for enums whose values are already sized deliberately
  # (ErrorCode is uint16_t because it is a wire field).
  -performance-enum-size,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -performance-avoid-endl,
  -readability-redundant-access-specifiers

# CI runs this with --warnings-as-errors. Note that clang-tidy must match the
# compiler's standard library: running Homebrew clang-tidy against Apple's
# libc++ produces a flood of 'file not found' errors and, worse, false
# positives from the half-parsed translation unit (it reported four infinite
# loops that plainly update their condition variable). Use the clang-tidy that
# ships with your compiler.
WarningsAsErrors: ''
HeaderFilterRegex: '.*/(include/pulselog|src|clients/cpp)/.*'
FormatStyle: file

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
